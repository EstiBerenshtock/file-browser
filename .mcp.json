{
  "mcpServers": {
    "file-browser-server": {
      "type": "stdio",
      "command": "node",
      "args": ["--experimental-strip-types", "mcp_servers/file-browser.ts"],
      "env": { 
        "THEME": "${THEME:-dark}" 
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "codebase-memory-mcp"],
      "env": {}
    }
  }
}