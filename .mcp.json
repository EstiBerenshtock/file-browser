{
  "mcpServers": {
    "file-browser-server": {
      "type": "stdio",
      "command": "node",
      "args": ["--experimental-strip-types", "mcp_servers/file-browser.ts"],
      "env": { 
        "THEME": "${THEME:-dark}" 
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": [],
      "env": {}
    }
  }
}